<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ViewModels"
             x:Class="Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Title="{Binding Title}"
             Shell.FlyoutBehavior="Disabled">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Gray200">#C8C8C8</Color>
            <Color x:Key="Gray900">#212121</Color>
            <Color x:Key="White">#FFFFFF</Color>
            <Color x:Key="Gray950">#141414</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20">

        <Border StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="400"
                Padding="30">

            <VerticalStackLayout Spacing="25"
                                 HorizontalOptions="Fill">

                <Image Source="welcome_shell.png"
                       HeightRequest="140"
                       HorizontalOptions="Center"/>

                <Label Text="ברוכים הבאים"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <Button Text="מחשבון מתמטי"
                        Command="{Binding NavigateToCalculatorCommand}"
                        WidthRequest="200"/>

                <Button Text="מחשבון נוסף"
                        Command="{Binding NavigateToSecondCalculatorCommand}"
                        WidthRequest="200"/>

                <Button Text="מחשבון טמפרטורה"
                        Command="{Binding NavigateToTempCalcCommand}"
                        WidthRequest="200"/>
                
                <Button Text="מחשבון מטבעות"
                        Command="{Binding NavigateToCurrencyCalcCommand}"
                        WidthRequest="200"/>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
