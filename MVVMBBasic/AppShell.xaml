<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MVVMBBasic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Views"
    FlyoutBehavior="Flyout"
    Title="MVVMBBasic">

    <!-- דף פתיחה -->
    <ShellContent
        Title="Welcome"
        Route="WelcomePage"
        ContentTemplate="{DataTemplate views:WelcomePage}" />

    <!-- תפריט מחשבונים -->
    <FlyoutItem Title="מחשבונים">

        <ShellContent
            Title="מחשבון מתמטי"
            Route="CalculatorPage"
            ContentTemplate="{DataTemplate views:CalculatorPage}" />

        <ShellContent
            Title="מחשבון גיל"
            Route="SecondCalculatorPage"
            ContentTemplate="{DataTemplate views:CalcAgePage}" />

    </FlyoutItem>

</Shell>
