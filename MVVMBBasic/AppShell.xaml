<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MVVMBBasic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Views"
    FlyoutBehavior="Flyout"
    Title="MVVMBBasic">

    <ShellContent
        Title="Welcome"
        Route="WelcomePage"
        ContentTemplate="{DataTemplate views:WelcomePage}" />

    <FlyoutItem Title="מחשבונים"
                Route="Calculators">

        <ShellContent
            Title="מחשבון מתמטי"
            Route="CalculatorPage"
            ContentTemplate="{DataTemplate views:CalculatorPage}" />

        <ShellContent
            Title="מחשבון גיל"
            Route="SecondCalculatorPage"
            ContentTemplate="{DataTemplate views:CalcAgePage}" />

        <ShellContent
            Title="מחשבון טמפרטורה"
            Route="TempCalc"
            ContentTemplate="{DataTemplate views:TempCalcPage}" />

        <ShellContent
           Title="מחשבון מטבעות"
           Route="CurrCalc"
           ContentTemplate="{DataTemplate views:CurrCalcPage}" />
        <ShellContent 
            Title="ניהול משימות"
            Route="TaskPage"
            ContentTemplate="{DataTemplate views:TaskPage}" />

    </FlyoutItem>

</Shell>